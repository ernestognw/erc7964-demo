# WalletConnect (needed for RainbowKit's WalletConnect support)
# Get one at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# Optional RPC overrides (public RPCs rate-limit; recommend Alchemy/Infura)
VITE_RPC_SEPOLIA=
VITE_RPC_ARBITRUM_SEPOLIA=
VITE_RPC_BASE_SEPOLIA=

# Deployed CrossChainAppMock addresses per chain.
# Run `forge script script/Deploy.s.sol --rpc-url $RPC_* --private-key $PRIVATE_KEY --broadcast`
# once per chain and paste the resulting addresses here.
VITE_APP_SEPOLIA=
VITE_APP_ARBITRUM_SEPOLIA=
VITE_APP_BASE_SEPOLIA=

# Required for the Foundry deploy script.
PRIVATE_KEY=
RPC_SEPOLIA=
RPC_ARBITRUM_SEPOLIA=
RPC_BASE_SEPOLIA=
